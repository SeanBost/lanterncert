---
const links = [
	{ href: "/#certifications", label: "Certifications" },
	{ href: "/about", label: "About" },
	{ href: "/progress", label: "My Progress" },
];

// Compared without the hash, so "/#certifications" marks the homepage it points into.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href) => (href.split("#")[0].replace(/\/+$/, "") || "/") === here;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__brand" href="/">
			<img
				class="site-header__logo"
				src="/lanterncert-logo.png"
				alt="LanternCert"
				width="1240"
				height="160"
			/>
		</a>
		<button
			class="site-header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Menu"
		>
			<span></span><span></span><span></span>
		</button>
		<nav class="site-nav" id="site-nav" aria-label="Main">
			<ul class="site-nav__list">
				{links.map((link) => (
					<li>
						<a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector(".site-header");
	const toggle = /** @type {HTMLButtonElement | null} */ (
		header?.querySelector(".site-header__toggle") ?? null
	);
	const desktop = window.matchMedia("(min-width: 768px)");

	const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

	/** @param {boolean} open */
	function setOpen(open) {
		toggle?.setAttribute("aria-expanded", String(open));
		header?.classList.toggle("site-header--open", open);
		if (open) header?.classList.remove("site-header--hidden");
	}

	toggle?.addEventListener("click", () => setOpen(!isOpen()));

	// A tap on the scrim reports the header as its target, the scrim being a pseudo-element of it.
	header?.addEventListener("click", (event) => {
		if (event.target === header) setOpen(false);
	});

	// The keyboard's half of the same dismissal, since the scrim can only be tapped.
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape" || !isOpen()) return;
		setOpen(false);
		toggle?.focus();
	});

	// Hides on the way down, returns on the way up, at every width.
	let last = window.scrollY;
	window.addEventListener(
		"scroll",
		() => {
			const y = window.scrollY;
			if (!isOpen()) {
				// The 80px floor stops the header flickering away during a short bounce at the top.
				header?.classList.toggle("site-header--hidden", y > last && y > 80);
			}
			last = y;
		},
		{ passive: true },
	);

	// A hidden band must never swallow keyboard focus; tabbing into it brings it back.
	header?.addEventListener("focusin", () => header.classList.remove("site-header--hidden"));

	// The toggle is display:none from 768, so a panel left open on mobile would latch --open there.
	desktop.addEventListener("change", () => {
		setOpen(false);
		header?.classList.remove("site-header--hidden");
	});
</script>
