---
// The foot of a guide page: a card for each neighboring page, its direction over its emoji and name.
/** @type {{ prev?: { slug: string, name: string, emoji: string }, next?: { slug: string, name: string, emoji: string } }} */
const { prev, next } = Astro.props;
---

<div class="guide-topic__foot guide-pager">
	{prev && (
		<a class="guide-pager__link" href={`#${prev.slug}`}>
			<span class="guide-pager__dir"><span class="guide-pager__chevron" aria-hidden="true"></span>Previous<span class="visually-hidden"> topic:</span></span>
			<span class="guide-pager__name"><span aria-hidden="true">{prev.emoji}</span>{prev.name}</span>
		</a>
	)}
	{next && (
		<a class="guide-pager__link guide-pager__link--next" href={`#${next.slug}`}>
			<span class="guide-pager__dir">Next<span class="visually-hidden"> topic:</span><span class="guide-pager__chevron" aria-hidden="true"></span></span>
			<span class="guide-pager__name"><span aria-hidden="true">{next.emoji}</span>{next.name}</span>
		</a>
	)}
</div>
