---
// The three mode-card marks, as solid paths on a 24x24 viewBox.
const ICONS = {
	book: [{ d: "M3 4.5h4.6a3.8 3.8 0 0 1 3.8 3.8v11.5a2.8 2.8 0 0 0-2.8-2.8H3zM21 4.5h-4.6a3.8 3.8 0 0 0-3.8 3.8v11.5a2.8 2.8 0 0 1 2.8-2.8H21z" }],
	cards: [
		// evenodd: subpath 2 is the front card grown by 1.4, cutting the gap between the two.
		{ rule: "evenodd", d: "M10.6 3.8H18.4A2 2 0 0 1 20.4 5.8V14.8A2 2 0 0 1 18.4 16.8H10.6A2 2 0 0 1 8.6 14.8V5.8A2 2 0 0 1 10.6 3.8ZM6.8 5.8H14.6A3.4 3.4 0 0 1 18 9.2V18.2A3.4 3.4 0 0 1 14.6 21.6H6.8A3.4 3.4 0 0 1 3.4 18.2V9.2A3.4 3.4 0 0 1 6.8 5.8Z" },
		{ d: "M6.8 7.2H14.6A2 2 0 0 1 16.6 9.2V18.2A2 2 0 0 1 14.6 20.2H6.8A2 2 0 0 1 4.8 18.2V9.2A2 2 0 0 1 6.8 7.2Z" },
	],
	pencil: [{ d: "M3.4 20.6L7.7 19.91L4.09 16.3ZM8.25 19.36L4.64 15.75L14.08 6.32L17.68 9.92ZM18.23 9.38L14.62 5.77L17.2 3.2L20.8 6.8Z" }],
};

const { name } = Astro.props;
const paths = ICONS[name];
if (!paths) throw new Error(`ModeIcon: no icon named "${name}"`);

// Keyed by name so three icons on one page carry three distinct ids.
const gradientId = `mode-icon-gradient-${name}`;
---

{/* Decorative: the title beside it already names the mode. */}
<svg class="mode-icon" viewBox="0 0 24 24" fill={`url(#${gradientId})`} aria-hidden="true" focusable="false">
	{/* userSpaceOnUse spans the viewBox, giving a multi-path icon one continuous ramp. */}
	<linearGradient id={gradientId} x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
		<stop offset="0" stop-color="var(--color-orange-dark)" />
		<stop offset="1" stop-color="var(--color-orange)" />
	</linearGradient>
	{paths.map((path) => <path d={path.d} fill-rule={path.rule} />)}
</svg>
