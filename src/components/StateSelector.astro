---
// Plain links rather than a <select> that navigates: the list works before any JavaScript loads,
// and geo-guessing the state is a later enhancement layered on top of it.
import { stateInfo } from "../lib/cert-data.js";

const { cert, states, current = null, label = "Choose your state" } = Astro.props;
---

<nav class="stack" aria-label={label}>
	<h2 class="section-title">{label}</h2>
	<ul class="state-list">
		{
			states.map((slug) => {
				const info = stateInfo(slug);
				const isCurrent = slug === current;
				return (
					<li>
						<a
							class={`btn ${isCurrent ? "" : "btn--secondary"}`}
							href={`/${cert}/${slug}`}
							aria-current={isCurrent ? "page" : undefined}
						>
							{info ? info.name : slug}
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>
