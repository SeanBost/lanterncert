---
// Renders an <a> when given an href and a <button> otherwise — a control is never a heading, and a
// link is never a button. CLAUDE.md ▸ Conventions.
const { href, variant = "primary", type = "button", ...rest } = Astro.props;

const classes = ["btn", variant === "secondary" && "btn--secondary"].filter(Boolean).join(" ");
const external = typeof href === "string" && /^https?:\/\//.test(href);
---

{
	href ? (
		<a
			class={classes}
			href={href}
			{...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
			{...rest}
		>
			<slot />
		</a>
	) : (
		<button class={classes} type={type} {...rest}>
			<slot />
		</button>
	)
}
