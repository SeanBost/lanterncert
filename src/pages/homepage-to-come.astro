---
import Layout from "../layouts/Layout.astro";
import StateAutocomplete from "../components/StateAutocomplete.astro";
import { certs, loadAllSources } from "../lib/cert-data.js";

const list = Object.values(certs);

// The madlib fills its cert from the registry; at cert #2 this half becomes a control of its own.
const [primary] = list;

const sources = (await Promise.all(list.map((cert) => loadAllSources(cert.slug)))).flat();

// Round-robin by scope so the top of the wall shows the mix rather than one agency's run.
// Sorted before grouping, so each group inherits title order without a second sort.
const sorted = sources.sort((a, b) => a.title.localeCompare(b.title));

/** @type {Map<string, any[]>} */
const byScope = new Map();
for (const source of sorted) {
	if (!byScope.has(source.state)) byScope.set(source.state, []);
	byScope.get(source.state).push(source);
}

/** @type {any[]} */
const mixed = [];
for (let i = 0; mixed.length < sorted.length; i++) {
	for (const group of byScope.values()) if (group[i]) mixed.push(group[i]);
}

// TEMP - the first bricks of the wall, off the state mix so titles and URLs vary in length.
// Alternating row counts, with the odd ones offset, is what reads as brickwork.
const rowSizes = [3, 4, 3, 4, 3, 4, 3];
/** @type {any[][]} */
const wallRows = [];
let taken = 0;
for (const size of rowSizes) {
	wallRows.push(mixed.slice(taken, taken + size));
	taken += size;
}
---

{/*
  WORKING PAGE - not the real homepage. Parked here so the live site keeps serving its placeholder
  while this gets built out.

  TO PROMOTE IT AT LAUNCH:
    1. Copy everything from the frontmatter fence down into src/pages/index.astro, replacing the
       placeholder markup there entirely.
    2. Delete this file. Nothing links to it, so nothing else needs changing.
    3. Rebuild and confirm / renders this and /homepage-to-come is gone.

  Keep bareTitle on the Layout below - the homepage is the one page exempt from the
  "[title] - LanternCert" standard.

  Keep id="certifications" on the certifications section too - the header's first nav item is
  /#certifications, and it is dead until this page is the one serving /.
*/}

<Layout
	title="LanternCert - Learn what matters"
	bareTitle
	description="Free, no-signup info and practice tests for certification exams, with every fact cited to the agency that publishes it."
>
	<div class="stack-xl">
		<div class="split split--even">
			<div class="stack-lg">
				<div class="stack">
					<h1 class="page-title page-title--hero">
						Learn <em class="sweep-in">exactly</em> what gets you
						<span class="page-title__accent">certified</span>
					</h1>
					<p class="lede">
						Quick facts, free practice tests, and what the certification process is like. 
            All cited and linked on-page.
					</p>
				</div>

				<div class="madlib-block">
					<p class="madlib">I want my <strong>{primary.name.toLowerCase()}</strong> in</p>
					<StateAutocomplete base={`/${primary.slug}`} submitLabel="Start learning" value="Georgia" />
				</div>
			</div>

			{/* PLACEHOLDER - the first bricks of the source mosaic that fills this column. */}
			<div class="hero-art">
				<div class="source-wall" id="source-wall">
					{
						wallRows.map((row, i) => (
							<ul class:list={["source-wall__row", i % 2 === 0 && "source-wall__row--offset"]}>
								{row.map((source) => (
									<li>
										<a
											class="source-tile"
											href={source.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											<span class="source-tile__line source-tile__title">{source.title}</span>
											<span class="source-tile__line source-tile__host">{source.url}</span>
										</a>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		</div>

		<div class="split">
			<section class="stack" aria-labelledby="trust-heading">
        <h2 class="section-title" id="trust-heading">Everything to know in one place, cited</h2>
				<div class="prose">
					<p>
						AI overviews and other prep sites confidently omit important-to-know details. 
            Government sources overcomplicate sharing how things work. 
						LanternCert organizes everything you need to know to get certified in a single place, and transparently links every source. 
					</p>
					<p>
						Discover what your certification journey looks like, then study and take practice tests on what your exam will cover.
						See where every fact and question's material was validated to reinforce and further your learning. 
					</p>
				</div>
			</section>

			<section aria-labelledby="correction-heading">
				<div class="card stack">
					<h3 class="card__title" id="correction-heading">Don't settle for sorta</h3>

					<dl class="correction">
						<div class="correction__row correction__row--wrong">
							<dt class="correction__label">What others have claimed</dt>
							<dd class="correction__value">20 questions, 75% or 80% to pass</dd>
						</div>
						<div class="correction__row correction__row--right">
							<dt class="correction__label">What LanternCert makes clear</dt>
							<dd class="correction__value">
								Two 20-question sections, Road Rules and Road Signs, needing 15 right on each
							</dd>
						</div>
					</dl>

					<p>
						<span class="label">Source:</span>{" "}
						<a
							href="https://dds.georgia.gov/testing-and-training/test-and-exams-information"
							target="_blank"
							rel="noopener noreferrer"
						>
							Georgia DDS: Test and Exams Information
						</a>
					</p>
				</div>
			</section>
		</div>

		<section class="stack" aria-labelledby="certs-heading" id="certifications">
			<h2 class="section-title" id="certs-heading">Certifications we cover</h2>
			<ul class="row-list col-main">
				{
					list.map((cert) => (
						<li>
							<h3 class="row-list__title">
								<a href={`/${cert.slug}`}>{cert.name}</a>
							</h3>
							<p>{cert.blurb}</p>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Layout>

<script>
	import { initHeroArt } from "../scripts/hero-art.js";

	initHeroArt();
</script>
