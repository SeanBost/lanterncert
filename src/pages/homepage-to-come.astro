---
import Layout from "../layouts/Layout.astro";
import StateAutocomplete from "../components/StateAutocomplete.astro";
import { displayedCerts, loadAllSources, loadSourceEntries, loadState } from "../lib/cert-data.js";

const list = displayedCerts;

// Georgia until there is a sourced correction per state. The link and the date come from the
// registry rather than the copy, so the homepage can never cite a stale URL.
const CORRECTION = { cert: "motorcycle-endorsement", state: "ga", sourceId: "ga-dds-test-exams" };
const correctionFacts = await loadState(CORRECTION.cert, CORRECTION.state);
const [correctionSource] = await loadSourceEntries(CORRECTION.cert, [CORRECTION.sourceId]);
// Hand-typed, and loadSourceEntries drops an id the registry doesn't hold - so this has to fail loudly.
if (!correctionSource) {
	throw new Error(`homepage correction: ${CORRECTION.sourceId} is not in the ${CORRECTION.cert} registry`);
}

// Split so the address bar can weight the host over the path, the way a real one does.
const correctionUrl = new URL(correctionSource.url);

// Parsed and formatted as UTC — a local-timezone render of a bare date lands a day early.
const [cy, cm, cd] = correctionFacts.meta.dateVerified.split("-").map(Number);
const correctionVerified = new Date(Date.UTC(cy, cm - 1, cd)).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

// The madlib fills its cert from the registry; at cert #2 this half becomes a control of its own.
const [primary] = list;
// The homepage cannot name a cert it may not link to, so an all-undisplayed registry has no homepage.
if (!primary) {
	throw new Error("homepage: no cert has displayOnSite true - site-config.json ▸ certTypes");
}

const sources = (await Promise.all(list.map((cert) => loadAllSources(cert.slug)))).flat();

// Round-robin by scope so the top of the wall shows the mix rather than one agency's run.
// Sorted before grouping, so each group inherits title order without a second sort.
const sorted = sources.sort((a, b) => a.title.localeCompare(b.title));

/** @type {Map<string, any[]>} */
const byScope = new Map();
for (const source of sorted) {
	if (!byScope.has(source.state)) byScope.set(source.state, []);
	byScope.get(source.state).push(source);
}

/** @type {any[]} */
const mixed = [];
for (let i = 0; mixed.length < sorted.length; i++) {
	for (const group of byScope.values()) if (group[i]) mixed.push(group[i]);
}

// TEMP - the first bricks of the wall, off the state mix so titles and URLs vary in length.
// Alternating row counts, with the odd ones offset, is what reads as brickwork.
const rowSizes = [3, 4, 3, 4, 3, 4, 3];
/** @type {any[][]} */
const wallRows = [];
let taken = 0;
for (const size of rowSizes) {
	wallRows.push(mixed.slice(taken, taken + size));
	taken += size;
}
---

{/*
  WORKING PAGE - not the real homepage. Parked here so the live site keeps serving its placeholder
  while this gets built out.

  TO PROMOTE IT AT LAUNCH:
    1. Copy everything from the frontmatter fence down into src/pages/index.astro, replacing the
       placeholder markup there entirely.
    2. Delete this file. Nothing links to it, so nothing else needs changing.
    3. Rebuild and confirm / renders this and /homepage-to-come is gone.

  Keep bareTitle on the Layout below - the homepage is the one page exempt from the
  "[title] - LanternCert" standard.

  Keep id="certifications" on the certifications section too - the header's first nav item is
  /#certifications, and it is dead until this page is the one serving /.
*/}

<Layout
	title="LanternCert - Learn exactly what gets you certified"
	bareTitle
	description="Free info and practice tests for earning certifications, with every fact cited to the agency that publishes it. No ads, and no signup needed."
	geo
	fonts={["Montserrat:wght@100..900", "Roboto:wght@100..900"]}
>
	<div class="bands">
		<div class="split split--even band band--wash">
			<div class="stack-lg">
				<div class="stack">
					<h1 class="page-title page-title--hero">
						Learn <em>exactly</em> what gets you
						<span class="page-title__accent sweep-in">certified</span>
					</h1>
					<div class="prose">
						<p>
							Requirements, exam prep, and what the certification process is like.
							All cited and linked on-page.
						</p>
					</div>
				</div>

				<div class="madlib-block">
					<p class="madlib">I want my <strong>{primary.name.toLowerCase()}</strong> in</p>
					<StateAutocomplete base={`/${primary.slug}`} submitLabel="Start learning" value="Georgia" geo />
				</div>

        {/* Each mark is decorative - the sentence beside it carries the meaning on its own. */}
        <ul class="assurances">
          <li>
            {/* <img class="caption__icon" src="/lanterncert-icon-mini.png" alt="" width="64" height="64" /> icons parked for emojis*/}
            <span aria-hidden="true">🔓</span> No ads, paywalls, or signup
          </li>
          <li>
            {/* <img class="caption__icon" src="/lanterncert-icon-mini.png" alt="" width="64" height="64" />*/}
            <span aria-hidden="true">🏛️</span> Backed by {sources.length} official sources
          </li>
        </ul>
			</div>

			<div class="hero-art">
				<div class="source-wall" id="source-wall">
					{
						wallRows.map((row, i) => (
							<ul class:list={["source-wall__row", i % 2 === 0 && "source-wall__row--offset"]}>
								{row.map((source) => (
									<li>
										{/* Out of the tab order on purpose - the wall is artwork, and hero-art.js may never touch this. */}
										<a
											class="source-tile"
											href={source.url}
											target="_blank"
											rel="noopener noreferrer"
											tabindex="-1"
										>
											<span class="source-tile__line source-tile__title">{source.title}</span>
											<span class="source-tile__line source-tile__host">{source.url}</span>
										</a>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		</div>

		<div class="split band band--warm">
			<section class="stack band-warm-blur" aria-labelledby="trust-heading">
        <h2 class="section-title section-title--lg" id="trust-heading">Everything you need to know, <span class="text-accent">cited</span></h2>
				<div class="prose">
          <p>
            Figuring out how to get certified is tedious and confusing.
						AI overviews will often confidently omit important-to-know details, 
            and certification agencies overcomplicate how and where they share their requirements. 
					</p>
          <p>
						LanternCert organizes <strong class="text-key">what you need to know in a single place</strong>. 
            Every fact and practice question provided is backed by an official source that's been vetted and linked to.
            Get the big picture at a glance, then dig into the details that matter most to you.
          </p>
          <p>
						See what the certification you're working towards requires, then study and take practice tests to get exam-ready.
					</p>
				</div>
			</section>

			{/* The label sits OUTSIDE the struck line on purpose: text-decoration propagates to
			    descendants and a child cannot turn an ancestor's line off. */}
			<section class="stack correction" aria-label="A claim about Georgia's exam, beside what Georgia DDS publishes">
				{/*<h3 class="correction__title" id="correction-heading"><em>Don't settle for sorta</em></h3>*/}

				{/* <p>Others often muddy important details, like with Georgia's Knowledge Exam.</p> */}

				{/* Exhibited as the problem, never cited as evidence - this must never enter the sources registry.
				    Trimmed to two contiguous fragments; nothing dropped carried a qualifier. */}
				<figure class="correction__evidence">
					<div class="correction__browser">
						<div class="correction__chrome">
							<span class="correction__dots" aria-hidden="true"></span>
							<div class="correction__bar">
								<svg class="correction__glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
									<circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
									<line
										x1="10.6"
										y1="10.6"
										x2="14"
										y2="14"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
									/>
								</svg>
								<span class="correction__search">georgia motorcycle exam questions</span>
							</div>
						</div>
						<blockquote class="correction__overview">
							&#8230;the Class M motorcycle knowledge test consists of 20 multiple-choice
							questions&#8230; You must answer at least 15 questions correctly (75% to 80%) to
							pass.
						</blockquote>
					</div>
          <p class="correction__label">What an AI overview claimed, searched August 23, 2026</p>
				</figure>

				<figure class="correction__evidence">
					{/* A window onto their page. The address bar is the block's ONLY attribution now, so it is
					    a real link and only the dots are hidden - see the note on .correction__url. */}
					<div class="correction__browser">
						<div class="correction__chrome">
							<span class="correction__dots" aria-hidden="true"></span>
							<div class="correction__bar">
								<a
									class="correction__url"
									href={correctionSource.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									{/* The visible text is a bare URL, which is a poor accessible name on its own. The
									    prefix is included in the name, so WCAG 2.5.3 still holds. */}
									<span class="visually-hidden">Source: </span><span class="correction__host"
										>{correctionUrl.host}</span
									>{correctionUrl.pathname}
								</a>
							</div>
						</div>
						{/* Verbatim, and set in the publisher's own face - see .correction__quote in global.css. */}
						<blockquote class="correction__quote" cite={correctionSource.url}>
							The Knowledge Exam includes <span class="correction__key">two tests</span>: the Road Rules
							Test and the Road Signs Test, both requiring a minimum score of 15 out of 20 to pass.
						</blockquote>
					</div>
					{/*<figcaption class="correction__source">
						<a href={correctionSource.url} target="_blank" rel="noopener noreferrer">
							{correctionSource.title}
						</a>
						<span class="correction__meta">
							{correctionSource.publisher}, verified {correctionVerified}
						</span>
					</figcaption>*/}
          <p class="correction__label">What Georgia DDS actually publishes, verified August 14, 2026</p>
				</figure>
			</section>
		</div>

		<section class="stack band band--wash" aria-labelledby="certs-heading" id="certifications">
			<h2 class="section-title section-title--lg" id="certs-heading">Certifications we cover</h2>
			<ul class="row-list accent-edge col-main">
				{
					list.map((cert) => (
						<li>
							{/* Decorative - the cert's own name is the link text and carries it alone. */}
							<span class="row-list__mark" aria-hidden="true">{cert.emoji}</span>
							<h3 class="row-list__title">
								<a href={`/${cert.slug}`}>{cert.name}</a>
							</h3>
							<p>{cert.blurb}</p>
						</li>
					))
				}
			</ul>
      <div class="prose">
        <p class="col-main">
          Check back soon, we're always adding more.
        </p>
      </div>
		</section>
	</div>
</Layout>

<script>
	import { initHeroArt } from "../scripts/hero-art.js";
	import { initCorrection } from "../scripts/correction.js";

	initHeroArt();
	initCorrection();
</script>
