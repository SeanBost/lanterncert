---
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import { certStatePaths, stateInfo, loadState, loadSources } from "../../../lib/cert-data.js";
import { formatFact } from "../../../lib/format-fact.js";
import { placeholderTopics } from "../../../lib/placeholder-topics.js";

export async function getStaticPaths() {
	return await certStatePaths();
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
const { cited, extra } = await loadSources(cert, facts);

const term = facts.meta.localTerm;
const base = `/${cert}/${state}`;

// A sectioned exam scores each part separately, so a bare percentage next to a total question count
// reads as one global threshold and can tell a rider they passed a test they failed. The label has
// to carry the gate. CLAUDE.md ▸ Gotchas ▸ Process.
const sectioned = facts.exam.isExamSectioned.value === true;

// Unit per fact so the shared formatter stays the only place a value becomes text.
const quickFacts = [
	["Minimum age", formatFact(facts.criteria.minAge.value, "years")],
	["Agency fees", formatFact(facts.criteria.dmvCost.value, "usd")],
	["Course cost", formatFact(facts.criteria.classCost.value, "usd")],
	[sectioned ? "Questions in total" : "Questions on the test", formatFact(facts.exam.questionCount.value)],
	[
		sectioned ? "Passing score on each section" : "Passing score",
		formatFact(facts.exam.passingScorePercent.value, "percent"),
	],
	["Time limit", formatFact(facts.exam.timeLimitMinutes.value, "minutes")],
];

const modes = [
	{ href: `${base}/study`, title: "Study", blurb: "Work through the material one card at a time." },
	{ href: `${base}/practice`, title: "Practice", blurb: "Answer questions with instant feedback." },
	{ href: `${base}/test`, title: "Mock exam", blurb: `Sit a timed test shaped like ${facts.meta.agencyCode}'s.` },
	{ href: `${base}/guide`, title: "Study guide", blurb: "Read up on one topic at a time." },
];
---

<Layout
	title={`${info.name} ${term}`}
	description={`How to get your ${term} in ${info.name} - requirements, costs and test details from ${facts.meta.agencyName}, plus free practice questions.`}
>
	<div class="stack-lg">
		<div class="stack">
			<h1 class="page-title">{info.name} {term}</h1>
			<p class="lede">
				What {facts.meta.agencyCode} requires, what it costs, and free practice built from {info.name}'s
				own material.
			</p>
			<p><span class="badge">Verified {facts.meta.dateVerified}</span></p>
		</div>

		<section class="stack" aria-labelledby="facts-heading">
			<h2 class="section-title" id="facts-heading">Quick facts</h2>
			<dl class="facts">
				{
					quickFacts.map(([label, value]) => (
						<div class="facts__row">
							<dt class="facts__label">{label}</dt>
							<dd class="facts__value">{value ?? "Not published"}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section class="stack" aria-labelledby="modes-heading">
			<h2 class="section-title" id="modes-heading">Start studying</h2>
			<ul class="card-grid">
				{
					modes.map((mode) => (
						<li>
							<Card title={mode.title} href={mode.href}>
								<p class="muted">{mode.blurb}</p>
							</Card>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="topics-heading">
			<h2 class="section-title" id="topics-heading">Guide topics</h2>
			<ul class="card-grid">
				{
					placeholderTopics.map((topic) => (
						<li>
							<Card title={topic.name} href={`${base}/guide/${topic.slug}`} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="sources-heading">
			<h2 class="section-title" id="sources-heading">Verified against</h2>
			<ul class="source-list">
				{
					cited.map((source) => (
						<li>
							<a href={source.url} target="_blank" rel="noopener noreferrer">
								{source.title}
							</a>
							<span class="source-list__meta">
								{" - "}
								{source.publisher}
								{source.published ? `, published ${source.published}` : ""}
								{source.verifiedCurrentIn ? ` · verified current in ${source.verifiedCurrentIn}` : ""}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		{
			extra.length > 0 && (
				<section class="stack" aria-labelledby="more-heading">
					<h2 class="section-title" id="more-heading">More from {facts.meta.agencyCode}</h2>
					<ul class="source-list">
						{extra.map((source) => (
							<li>
								<a href={source.url} target="_blank" rel="noopener noreferrer">
									{source.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</Layout>
