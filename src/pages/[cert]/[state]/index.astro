---
import Layout from "../../../layouts/Layout.astro";
import Card from "../../../components/Card.astro";
import {
	certStatePaths,
	citedSourceIds,
	// loadExtraSources,
	loadSourceEntries,
	loadState,
	stateInfo,
	tokenDisplay,
} from "../../../lib/cert-data.js";
import { formatFact } from "../../../lib/format-fact.js";
import { sourceMetaParts } from "../../../lib/format-source.js";
import { placeholderTopics } from "../../../lib/placeholder-topics.js";

export async function getStaticPaths() {
	return await certStatePaths();
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
// const extra = await loadExtraSources(cert, facts);

const term = facts.meta.localTerm;
const base = `/${cert}/${state}`;

// Parsed as UTC and formatted as UTC — a local-timezone render of a bare date lands a day early.
const [vy, vm, vd] = facts.meta.dateVerified.split("-").map(Number);
const validated = new Date(Date.UTC(vy, vm - 1, vd)).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

// The LABEL has to carry the per-section gate, or a rider reads a pass into a fail.
// CLAUDE.md ▸ Gotchas ▸ Process.
const sectioned = facts.exam.isExamSectioned.value === true;

/** @param {string | null} text */
const approx = (text) => (text === null ? null : `~${text}`);

/** @type {(list: any[][]) => { label: string, value: string | null, sourceId: string | null }[]} */
const rows = (list) =>
	list.map(([label, value, fact]) => ({ label, value, sourceId: fact.source?.id ?? null }));

const token = tokenDisplay(cert, facts);

const examRows = rows([
	["Questions in total", formatFact(facts.exam.questionCount.value), facts.exam.questionCount],
	[
		sectioned ? "Passing score for each section" : "Passing score",
		formatFact(facts.exam.passingScorePercent.value, "percent"),
		facts.exam.passingScorePercent,
	],
	["Time limit", formatFact(facts.exam.timeLimitMinutes.value, "minutes"), facts.exam.timeLimitMinutes],
]);

// A sourced null is "checked, nothing published"; an unsourced one is "nobody has looked". Only the
// first earns the sentence — the second would assert something about the state that we never verified.
const examUnpublished = examRows.every((row) => row.value === null && row.sourceId !== null);

// Grouped by the question a reader is asking, not by the shape of the facts file.
const factGroups = [
	{
		title: "Certification Requirements",
		fallback: null,
		facts: rows([
			["Minimum age", formatFact(facts.criteria.minAge.value, "years"), facts.criteria.minAge],
			["Minimum license", token("minLicense", facts.criteria.minLicense), facts.criteria.minLicense],
			[
				"Renewal period",
				formatFact(facts.criteria.renewalYears.value, "renewal"),
				facts.criteria.renewalYears,
			],
			[
				`${facts.meta.agencyCode} fees`,
				formatFact(facts.criteria.dmvCost.value, "usd"),
				facts.criteria.dmvCost,
			],
			// Providers set their own tuition, so the figure is approximate however precise the range looks.
			["Course cost", approx(formatFact(facts.criteria.classCost.value, "usd")), facts.criteria.classCost],
		]),
	},
	{
		title: "Exam Details",
		fallback: examUnpublished ? `${info.name} sets no statewide exam format.` : null,
		// The passing score is the most foundational exam property here, so its source is the one that
		// backs a sentence standing in for the whole group. Never assume the nulls share a source.
		fallbackSource: facts.exam.passingScorePercent.source?.id ?? null,
		facts: examRows,
	},
];

// Numbered in the order markers appear, so a null value doesn't burn a number. A fallback sentence is
// itself a claim, so it takes a number too.
// The last loop keeps a source backing an unsurfaced fact on the page it provides provenance for.
const citations = new Map();
for (const group of factGroups) {
	if (group.fallback) {
		const id = group.fallbackSource;
		if (id && !citations.has(id)) citations.set(id, citations.size + 1);
		continue;
	}
	for (const fact of group.facts) {
		if (fact.value === null || !fact.sourceId) continue;
		if (!citations.has(fact.sourceId)) citations.set(fact.sourceId, citations.size + 1);
	}
}
const groups = factGroups.map((group) => ({
	...group,
	cite: group.fallback ? (citations.get(group.fallbackSource) ?? null) : null,
}));
for (const id of citedSourceIds(facts)) {
	if (!citations.has(id)) citations.set(id, citations.size + 1);
}
const cited = await loadSourceEntries(cert, [...citations.keys()]);

const modes = [
	{ href: `${base}/study`, title: "Study", blurb: "Work through the material one card at a time." },
	{ href: `${base}/practice`, title: "Practice", blurb: "Answer questions with instant feedback." },
	{ href: `${base}/test`, title: "Mock test", blurb: `Sit a timed test shaped like the real ${facts.meta.agencyCode} exam.` },
	{ href: `${base}/guide`, title: "Study guide", blurb: "Read up on one topic at a time." },
];
---

<Layout
	title={`${info.name} ${term}`}
	description={`How to get your ${term} in ${info.name} - requirements, costs and exam details from ${facts.meta.agencyName}, plus free practice questions.`}
>
	<div class="stack-lg">
		<div class="split">
			<div class="stack">
				<h1 class="page-title">{info.name} {term}</h1>
				<p class="caption">All information last validated {validated}.</p>
				{/* Placeholder for the per-cert generated summary, which will carry its own citations. */}
				<div class="prose">
					<p>
						What {facts.meta.agencyCode} requires, what it costs, and free practice built from {info.name}'s
						own material.
					</p>
				</div>
			</div>

			<section class="stack baseline-drop" aria-labelledby="facts-heading">
				<h2 class="section-title" id="facts-heading">What you need to know</h2>
				{/* A div, not a dl — a heading cannot live inside a dl, so each group brings its own. */}
				<div class="facts accent-edge">
					{
						groups.map((group) => (
							<Fragment>
								<h3 class="facts__group">{group.title}</h3>
								{/* No whitespace inside the p — the marker hugs the sentence it backs. */}
								{group.fallback ? (
									<p class="facts__empty">
										{group.fallback}{group.cite && <a class="cite" href={`#source-${group.cite}`}>[{group.cite}]</a>}
									</p>
								) : (
									<dl>
										{group.facts.map((fact) => {
											const number = fact.value === null ? null : citations.get(fact.sourceId);
											return (
												<div class="facts__row">
													<dt>{fact.label}</dt>
													{/* No whitespace between the two — a superscript citation hugs its value. */}
													<dd class="facts__value">
														{fact.value ?? "Not published"}{number && <a class="cite" href={`#source-${number}`}>[{number}]</a>}
													</dd>
												</div>
											);
										})}
									</dl>
								)}
							</Fragment>
						))
					}
				</div>
			</section>
		</div>

		<section class="stack" aria-labelledby="modes-heading">
			<h2 class="section-title" id="modes-heading">Start studying</h2>
			<ul class="card-grid">
				{
					modes.map((mode) => (
						<li>
							<Card title={mode.title} href={mode.href}>
								<p>{mode.blurb}</p>
							</Card>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="topics-heading">
			<h2 class="section-title" id="topics-heading">Guide topics</h2>
			<ul class="card-grid">
				{
					placeholderTopics.map((topic) => (
						<li>
							<Card title={topic.name} href={`${base}/guide/${topic.slug}`} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="sources-heading">
			<h2 class="section-title" id="sources-heading">Sources</h2>
			<ol class="source-list">
				{
					cited.map((source) => (
						<li id={`source-${citations.get(source.id)}`}>
							<a href={source.url} target="_blank" rel="noopener noreferrer">
								{source.title}
							</a>
							<span class="source-list__meta">{source.description}</span>
							{/* Separators are their own spans so the italic can skip them. */}
							<span class="source-list__meta source-list__verify">
								{sourceMetaParts(source).map((part, i) => (
									<Fragment>
										{i > 0 && <span class="source-list__sep">|</span>}
										{part}
									</Fragment>
								))}
							</span>
						</li>
					))
				}
			</ol>
		</section>

		{/*
		  PARKED - uncited sources competed with the Sources list above for a reader's attention.
		  Restoring it means uncommenting the loadExtraSources import and the `extra` const too.

		{
			extra.length > 0 && (
				<section class="stack" aria-labelledby="more-heading">
					Named for the state, not the agency - the list holds documents it did not publish.
					<h2 class="section-title" id="more-heading">Additional {info.name} resources</h2>
					<ul class="source-list">
						{extra.map((source) => (
							<li>
								<a href={source.url} target="_blank" rel="noopener noreferrer">
									{source.title}
								</a>
								<span class="source-list__meta">{source.description}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
		*/}
	</div>
</Layout>
