---
import Layout from "../../../layouts/Layout.astro";
import Button from "../../../components/Button.astro";
import Card from "../../../components/Card.astro";
import {
	certIntro,
	certStatePaths,
	citedSourceIds,
	// loadExtraSources,
	loadSourceEntries,
	loadState,
	stateInfo,
	tokenDisplay,
} from "../../../lib/cert-data.js";
import { formatFact } from "../../../lib/format-fact.js";
import { sourceMetaParts } from "../../../lib/format-source.js";
import { stateIntro } from "../../../lib/state-intro.js";

export async function getStaticPaths() {
	return await certStatePaths();
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
// const extra = await loadExtraSources(cert, facts);

const term = facts.meta.localTerm;
const base = `/${cert}/${state}`;

// Parsed as UTC and formatted as UTC — a local-timezone render of a bare date lands a day early.
const [vy, vm, vd] = facts.meta.dateVerified.split("-").map(Number);
const validated = new Date(Date.UTC(vy, vm - 1, vd)).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

// The LABEL has to carry the per-section gate, or a rider reads a pass into a fail.
// CLAUDE.md ▸ Gotchas ▸ Process.
const sectioned = facts.exam.isExamSectioned.value === true;

/** @param {string | null} text */
const approx = (text) => (text === null ? null : `~${text}`);

/** @type {(list: any[][]) => { label: string, value: string | null, sourceId: string | null }[]} */
const rows = (list) =>
	list.map(([label, value, fact]) => ({ label, value, sourceId: fact.source?.id ?? null }));

const token = tokenDisplay(cert, facts, { stateName: info.name, stateCode: info.abbreviation });

// ONE numbering rule for the whole page: a source takes its number the first time it appears
// anywhere, reading order - the lede paragraphs top to bottom, then the facts panel, then any
// source backing a fact the page never surfaces. That order is also the Sources list's order.
// The lede assigns its own numbers as it renders, which is what makes reading order automatic.
const citations = new Map();
/** @param {string | null} id */
const numberSource = (id) => {
	if (id && !citations.has(id)) citations.set(id, citations.size + 1);
	return id ? citations.get(id) : null;
};

// One template per cert, filled from this state. src/content/intro/<cert>-intro.json ▸ _about.
// tokenDisplay is built with asHtml because the lede renders through set:html.
const intro = stateIntro({
	cert,
	facts,
	stateName: info.name,
	template: certIntro(cert),
	token: tokenDisplay(cert, facts, { asHtml: true, stateName: info.name, stateCode: info.abbreviation }),
	hrefFor: (id) => `#source-${numberSource(id)}`,
});

const examRows = rows([
	["Questions in total", formatFact(facts.exam.questionCount.value), facts.exam.questionCount],
	[
		sectioned ? "Passing score for each section" : "Passing score",
		formatFact(facts.exam.passingScorePercent.value, "percent"),
		facts.exam.passingScorePercent,
	],
	["Time limit", formatFact(facts.exam.timeLimitMinutes.value, "minutes"), facts.exam.timeLimitMinutes],
]);

// A sourced null is "checked, nothing published"; an unsourced one is "nobody has looked". Only the
// first earns the sentence — the second would assert something about the state that we never verified.
const examUnpublished = examRows.every((row) => row.value === null && row.sourceId !== null);

// Grouped by the question a reader is asking, not by the shape of the facts file.
const factGroups = [
	{
		title: "Certification Requirements",
		fallback: null,
		facts: rows([
			["Minimum age", formatFact(facts.criteria.minAge.value, "years"), facts.criteria.minAge],
			["Prerequisite license", token("minLicense", facts.criteria.minLicense), facts.criteria.minLicense],
			[
				"Renewal period",
				formatFact(facts.criteria.renewalYears.value, "renewal"),
				facts.criteria.renewalYears,
			],
			[
				`${facts.meta.agencyCode} fees`,
				formatFact(facts.criteria.dmvCost.value, "usd"),
				facts.criteria.dmvCost,
			],
			// Providers set their own tuition, so the figure is approximate however precise the range looks.
			["Course cost", approx(formatFact(facts.criteria.classCost.value, "usd")), facts.criteria.classCost],
		]),
	},
	{
		title: "Exam Details",
		fallback: examUnpublished ? `${info.name} sets no statewide exam format.` : null,
		// The passing score is the most foundational exam property here, so its source is the one that
		// backs a sentence standing in for the whole group. Never assume the nulls share a source.
		fallbackSource: facts.exam.passingScorePercent.source?.id ?? null,
		facts: examRows,
	},
];

// Continues the numbering the lede started. A null value burns no number, and a fallback sentence
// is itself a claim, so it takes one.
for (const group of factGroups) {
	if (group.fallback) {
		numberSource(group.fallbackSource);
		continue;
	}
	for (const fact of group.facts) {
		if (fact.value === null) continue;
		numberSource(fact.sourceId);
	}
}
const groups = factGroups.map((group) => ({
	...group,
	cite: group.fallback ? (citations.get(group.fallbackSource) ?? null) : null,
}));
for (const id of citedSourceIds(facts)) {
	if (!citations.has(id)) citations.set(id, citations.size + 1);
}
const cited = await loadSourceEntries(cert, [...citations.keys()]);
// loadSourceEntries drops an id the registry does not hold, which would leave a numbered marker
// pointing at a source that never renders. A cite key is hand-typed, so this has to fail loudly.
if (cited.length !== citations.size) {
	const missing = [...citations.keys()].filter((id) => !cited.some((s) => s.id === id));
	throw new Error(`${state}: cited source not in the registry - ${missing.join(", ")}`);
}

// Order is the progression, and the three names are proper nouns. CLAUDE.md ▸ The three modes.
const modes = [
	{
		href: `${base}/guide`,
		title: "Study Guide",
		blurb: "Start here. A crash course in the material, sorted by topic, with the source behind every section.",
	},
	{
		href: `${base}/practice`,
		title: "Practice Cards",
		blurb: "One question at a time, untimed. Every answer comes with the reason and the source.",
	},
	{
		href: `${base}/test`,
		title: "Mock Test",
		// Naming the agency's exam only where the state actually sets one - same trigger as the panel's
		// fallback sentence, so the page never shapes a test after an exam that isn't published.
		blurb: examUnpublished
			? "Sit a timed test covering the essentials you need to know, scored at the end."
			: `Sit a timed test shaped like the real ${facts.meta.agencyCode} exam, scored at the end.`,
	},
];

// Where a rider goes to start for real, off our site. findCourse's own source IS that destination -
// a state directory or booking portal - so the CTA needs no second registry entry.
const courseSourceId = facts.criteria.findCourse.source?.id ?? null;
const [courseSource] = courseSourceId ? await loadSourceEntries(cert, [courseSourceId]) : [];
const courseUrl = courseSource?.url ?? null;

const quickLinks = [
	...modes.map((mode) => ({ label: mode.title, attrs: { href: mode.href } })),
	...(courseUrl
		? [
				{
					label: "Find a riding course",
					attrs: { href: courseUrl, target: "_blank", rel: "noopener noreferrer" },
				},
			]
		: []),
];
---

<Layout
	title={`${info.name} ${term}`}
	description={`How to get your ${term} in ${info.name} - requirements, costs and exam details from ${facts.meta.agencyName}, plus free practice questions.`}
>
	{/* stack-xl with both lower blocks tightened - the homepage's smaller row gap, 3rem / 5rem. */}
	<div class="stack-xl">
		<div class="split">
			<div class="stack">
				<h1 class="page-title">Getting your {term} in {info.name}</h1>
				<p class="caption"><em>All information last validated {validated}.</em></p>
				{/* The only CTAs above the fold. Separators are their own spans so they can be spaced
				    by margin, and hidden from assistive tech - punctuation, not content. The spaces
				    inside the span are the row's only break opportunities, and one on each side is
				    what keeps a pipe centered between its links. */}
				<p class="caption quick-links">
					Quick links:{" "}
					{quickLinks.map((link, i) => (
						<Fragment>{i > 0 && <span class="quick-links__sep" aria-hidden="true">{" | "}</span>}<a {...link.attrs}>{link.label}</a></Fragment>
					))}
				</p>
				{/* set:html because the template and the display strings are authored copy that may
				    carry markup. Everything out of the facts file is escaped before it gets here. */}
				<div class="prose">
					{intro.map((paragraph) => <p set:html={paragraph.html} />)}
				</div>
			</div>

			<section class="stack baseline-drop" aria-labelledby="facts-heading">
				<h2 class="section-title" id="facts-heading">What you need to know</h2>
				{/* A div, not a dl — a heading cannot live inside a dl, so each group brings its own. */}
				<div class="facts accent-edge">
					{
						groups.map((group) => (
							<Fragment>
								<h3 class="facts__group">{group.title}</h3>
								{/* No whitespace inside the p — the marker hugs the sentence it backs. */}
								{group.fallback ? (
									<p class="facts__empty">
										{group.fallback}{group.cite && <a class="cite" href={`#source-${group.cite}`}>[{group.cite}]</a>}
									</p>
								) : (
									<dl>
										{group.facts.map((fact) => {
											const number = fact.value === null ? null : citations.get(fact.sourceId);
											return (
												<div class="facts__row">
													<dt>{fact.label}</dt>
													{/* No whitespace between the two — a superscript citation hugs its value. */}
													<dd class="facts__value">
														{fact.value ?? "Not published"}{number && <a class="cite" href={`#source-${number}`}>[{number}]</a>}
													</dd>
												</div>
											);
										})}
									</dl>
								)}
							</Fragment>
						))
					}
				</div>
			</section>
		</div>

		<section class="stack gap-tight" aria-labelledby="modes-heading">
			<h2 class="section-title" id="modes-heading">Prepare to pass</h2>
			{/* An ordered list - the three are a progression, not a menu. --lit expects exactly three. */}
			<ol class="card-grid card-grid--lit">
				{
					modes.map((mode) => (
						<li>
							<Card title={mode.title} href={mode.href}>
								<div class="prose">
									<p>{mode.blurb}</p>
								</div>
								{/* The title links to the same place, so the mode is named for anyone hearing this alone. */}
								<p class="card__cta">
									<Button href={mode.href}>
										Get started<span class="visually-hidden"> with {mode.title}</span>
									</Button>
								</p>
							</Card>
						</li>
					))
				}
			</ol>
			{
				courseUrl && (
					<div class="prose">
						{/* The period rides inside the expression - a newline before it renders as a space. */}
						<p class="col-split-main">
							Ready to get your {term}?{" "}
							<a href={courseUrl} target="_blank" rel="noopener noreferrer">Find a riding course</a>.
						</p>
					</div>
				)
			}
		</section>

		<section class="stack gap-tight" aria-labelledby="sources-heading">
			<h2 class="section-title" id="sources-heading">Sources</h2>
			{/* role="list" restores the semantics Safari drops from a list-style: none list. */}
			<ol class="source-list accent-edge col-split-main" role="list">
				{
					cited.map((source) => (
						<li id={`source-${citations.get(source.id)}`}>
							<p class="source-list__title">
								<a href={source.url} target="_blank" rel="noopener noreferrer">
									{source.title}
								</a>
							</p>
							<span class="source-list__meta">{source.description}</span>
							{/* Separators are their own spans so the italic can skip them. */}
							<span class="source-list__meta source-list__verify">
								{sourceMetaParts(source).map((part, i) => (
									<Fragment>
										{i > 0 && <span class="source-list__sep">{" | "}</span>}
										{part}
									</Fragment>
								))}
							</span>
						</li>
					))
				}
			</ol>
		</section>

		{/*
		  PARKED - uncited sources competed with the Sources list above for a reader's attention.
		  Restoring it means uncommenting the loadExtraSources import and the `extra` const too.

		{
			extra.length > 0 && (
				<section class="stack" aria-labelledby="more-heading">
					Named for the state, not the agency - the list holds documents it did not publish.
					<h2 class="section-title" id="more-heading">Additional {info.name} resources</h2>
					<ul class="source-list">
						{extra.map((source) => (
							<li>
								<a href={source.url} target="_blank" rel="noopener noreferrer">
									{source.title}
								</a>
								<span class="source-list__meta">{source.description}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
		*/}
	</div>
</Layout>

<script>
	import { initCiteJump } from "../../../scripts/cite-jump.js";

	initCiteJump();
</script>
