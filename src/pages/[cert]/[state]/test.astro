---
import Layout from "../../../layouts/Layout.astro";
import Button from "../../../components/Button.astro";
import { certNoindex, certStatePaths, stateInfo, loadState } from "../../../lib/cert-data.js";

export async function getStaticPaths() {
	return await certStatePaths({ examOnly: true });
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
const term = facts.meta.localTerm;
---

<Layout
	title={`${info.name} ${term} Mock Test`}
	description={`Sit a timed ${info.name} ${term} Mock Test shaped like the real ${facts.meta.agencyCode} exam, then review every question you missed.`}
	noindex={certNoindex(cert)}
>
	<div class="stack prose">
		<h1 class="page-title">Mock Test</h1>
		<p>{info.name} {term}</p>
		<p>The timed test lands in Sprint 4.</p>
		<p><Button href={`/${cert}/${state}`} variant="secondary">Back to {info.name}</Button></p>
	</div>
</Layout>
