---
import Layout from "../../../../layouts/Layout.astro";
import Button from "../../../../components/Button.astro";
import { certNoindex, certStatePaths, stateInfo, loadState } from "../../../../lib/cert-data.js";

export async function getStaticPaths() {
	return await certStatePaths({ examOnly: true });
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
const term = facts.meta.localTerm;
---

<Layout
	title={`${info.name} ${term} Study Guide`}
	description={`A plain-language crash course in the ${info.name} ${term} material, sorted by topic and written from ${facts.meta.agencyCode}'s own documents.`}
	noindex={certNoindex(cert, facts)}
>
	<div class="stack prose">
		<h1 class="page-title">Study Guide</h1>
		<p>{info.name} {term}</p>
		<p>
			One sheet of the material, sorted by topic. Content is authored in Sprint 3; topics are
			sections of this page rather than pages of their own.
		</p>
		<p><Button href={`/${cert}/${state}`} variant="secondary">Back to {info.name}</Button></p>
	</div>
</Layout>
