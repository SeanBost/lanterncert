---
import Layout from "../../../layouts/Layout.astro";
import Button from "../../../components/Button.astro";
import { certStatePaths, stateInfo, loadState } from "../../../lib/cert-data.js";

export async function getStaticPaths() {
	return await certStatePaths();
}

const { cert, state } = Astro.params;
const info = stateInfo(state);
const facts = await loadState(cert, state);
const term = facts.meta.localTerm;
---

<Layout
	title={`${info.name} ${term} practice test`}
	description={`Free ${info.name} ${term} practice questions with instant feedback and an explanation for every answer.`}
>
	<div class="stack prose">
		<h1 class="page-title">Practice test</h1>
		<p class="lede">{info.name} {term}</p>
		<p>Practice questions land in Sprint 4, once the bank is authored in Sprint 3.</p>
		<p><Button href={`/${cert}/${state}`} variant="secondary">Back to {info.name}</Button></p>
	</div>
</Layout>
