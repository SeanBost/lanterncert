---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import LearnConfirm from "../components/learn/LearnConfirm.astro";
import { certs } from "../lib/cert-data.js";
import states from "../content/states.json";
import "../styles/learn.css";

// The zero state: what renders before the script reads this browser's store.
const stored = [
	["answers", "Question answer history", "None stored yet"],
	["tests", "Mock Test results", "None stored yet"],
	["cert", "Preferred certification", "None stored yet"],
	["state", "Preferred state", "None stored yet"],
	["tracking", "Progress tracking", "On"],
];

// The names the script labels stored progress with: each cert and every state.
const names = {
	certs: Object.fromEntries(Object.values(certs).map((c) => [c.slug, { name: c.name, short: c.slugShort }])),
	states: Object.fromEntries(Object.entries(states).map(([slug, s]) => [slug, s.name])),
};
---

{/* noindex is PERMANENT here - this page is per-device and must never be indexed, launch included. */}
<Layout
	title="Progress overview"
	description="See how far along you are, review past Mock Test scores, and manage the study data this browser keeps on your device."
	noindex
>
	<script type="application/json" id="progress-data" is:inline set:html={JSON.stringify(names)} />

	{/* Three full-bleed bands, alternating wash / warm / wash. */}
	<div class="bands">
		<div class="split band band--wash">
			<div class="stack-lg">
				<div class="stack">
					<h1 class="page-title">
						Progress overview
					</h1>
					<p class="caption" data-slot="zero-caption"><em>Nothing here yet - run through some Practice Cards or a Mock Test first.</em></p>
				</div>
				<section class="stack" aria-labelledby="next-heading">
					<h2 class="section-title" id="next-heading">Your <strong class="text-accent">next steps</strong></h2>
					<div class="prose">
						<p data-slot="next-text">
							To get started, find the certification you want to prepare for.
							Once you complete any Practice Cards or Mock Tests, your results and progress will get displayed on this page.
						</p>
					</div>
					<div class="button-row">
						<Button href="/#certifications" data-slot="next-button">Find a certification</Button>
					</div>
				</section>
			</div>

			<section class="stack baseline-drop" aria-labelledby="activity-heading">
				<h2 class="section-title" id="activity-heading">Recent activity</h2>
				<div class="stack framed activity-panel">
					<div class="prose" data-slot="activity-empty">
						<p>
							<em>No Practice Cards or Mock Tests yet. Your sessions will be listed here.</em>
						</p>
					</div>
					{/* Scrolls from 768, so it takes focus and carries a name for keyboard and screen reader users. */}
					<ul class="row-list activity-list" data-slot="activity" tabindex="0" aria-labelledby="activity-heading" hidden></ul>
				</div>
			</section>
		</div>

		<div class="band band--warm">
			<ul class="card-grid">
				<li>
					<section class="stack framed" aria-labelledby="missed-heading">
						<h2 class="section-title" id="missed-heading">Missed questions</h2>
						<div class="prose" data-slot="missed-empty">
							<p>
								<em>No missed questions. Any you get wrong will collect here for another try.</em>
							</p>
						</div>
						<ul class="row-list missed-list" data-slot="missed" hidden></ul>
					</section>
				</li>
			</ul>
		</div>

		{/* id is a link target - /about's privacy copy points at this section by name. */}
		<section class="band band--wash" aria-labelledby="data-heading" id="data">
			{/* The heading rides inside the column so the whole row shares one left edge. */}
			<div class="stack col-split-main col-center-start">
				<h2 class="section-title section-title--lg" id="data-heading">Your progress data</h2>
				<div class="prose">
					<p>
						Progress data is exclusively stored locally by your browser and device.
						See the <a href="/about#privacy">privacy and usage policy</a> for details.
					</p>
					<p>
						You can download or erase your data below if any is stored.
						You can also opt-out of progress tracking, however this will disable the features on this page that need it.
					</p>
				</div>

				{/* A div, not a dl - a heading cannot live inside a dl, so the group brings its own. */}
				<div class="facts accent-edge">
					<h3 class="facts__group">What's currently stored</h3>
					<dl>
						{
							stored.map(([key, label, value]) => (
								<div class="facts__row">
									<dt>{label}</dt>
									<dd class="facts__value" data-stored={key}>{value}</dd>
								</div>
							))
						}
					</dl>
				</div>

				{/* Enabled by the script once it can read this browser's store. */}
				<div class="button-row">
					<button class="tool-btn" type="button" data-action="download" disabled aria-describedby="data-note">Download data</button>
					<button class="tool-btn" type="button" data-action="erase" disabled aria-describedby="data-note">Erase data</button>
					<button class="tool-btn" type="button" data-action="tracking" disabled aria-describedby="data-note">Disable tracking</button>
				</div>
				<p class="progress-status" data-slot="status" role="status"></p>
				<p class="caption" id="data-note">
					<em>Warning: Erasing your data or disabling progress tracking will clear your existing progress permanently.
						Lost data cannot be recovered.
					</em>
				</p>
			</div>
		</section>
	</div>

	<LearnConfirm />
</Layout>

<script>
	import { initProgress } from "../scripts/progress.js";

	initProgress();
</script>
