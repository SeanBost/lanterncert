---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../lib/cert-data.js";
import { SCROLLED_PX } from "../scripts/global.js";

const {
	title,
	description,
	bareTitle = false,
	noindex = false,
	geo = false,
	// Extra Google Fonts specs for ONE page, e.g. "Montserrat:wght@100..900".
	fonts = [],
	// A JSON-LD object rendered into <head>, built from the data the page already renders.
	schema = null,
} = Astro.props;

// Title standard: "[brief self-describing title] - LanternCert", homepage excepted.
const pageTitle = bareTitle ? title : `${title} - ${site.name}`;

// Astro.site is undefined without an astro.config.mjs, so the origin comes from site-config.json.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, site.url).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		{/* A pending stylesheet blocks every script below it, so this has to stay above the first
		    <link> to start the request before first paint. src/scripts/autocomplete.js consumes it. */}
		{geo && (
			<script is:inline>
				window.__lanternGeo = fetch("/api/geo")
					.then((r) => (r.ok ? r.json() : null))
					.catch(() => null);
			</script>
		)}

		{/* Sets the chrome's scroll state before first paint. src/scripts/global.js owns it from there. */}
		<script define:vars={{ scrolledPx: SCROLLED_PX }}>
			const atTop = window.scrollY <= scrolledPx;
			document.documentElement.toggleAttribute("data-scrolled", !atTop);
			document.documentElement.toggleAttribute("data-at-top", atTop);
		</script>

		<meta name="generator" content={Astro.generator} />
		{/* Every browser but Safari prefers the vector; the .ico is the fallback, not a duplicate. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}

		{/* is:inline keeps Astro's bundler off it; the escape stops a "<" in the data closing the tag. */}
		{schema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
		)}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&display=swap"
			rel="stylesheet"
		/>
		{/* One family per link - a combined request has been seen to silently drop families, and a
		    missing face falls back looking plausible. */}
		{fonts.map((family) => (
			<link href={`https://fonts.googleapis.com/css2?family=${family}&display=swap`} rel="stylesheet" />
		))}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main" class="page">
			<slot />
		</main>
		<SiteFooter />

		<script>
			import { initGlobal } from "../scripts/global.js";

			initGlobal();
		</script>
	</body>
</html>
